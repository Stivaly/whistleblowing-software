# Copiar a docker/veridy-db.env (excluido de git) y completar. Ver docker/README-postgres.md.
#
# Rol de la aplicación (solo lee y escribe datos). La contraseña va aparte, en PGPASSWORD.
GLOBALEAKS_DB_URI=postgresql+psycopg2://veridy_app@<servidor>.postgres.database.azure.com:5432/veridy?sslmode=verify-full&sslrootcert=system
PGPASSWORD=<contraseña de veridy_app, desde Key Vault: veridy-db-app-password>

# Solo para el PRIMER arranque (crea las tablas). Comentar después.
# GLOBALEAKS_DB_ADMIN_URI=postgresql+psycopg2://veridyadmin:<contraseña url-encoded>@<servidor>.postgres.database.azure.com:5432/veridy?sslmode=verify-full&sslrootcert=system
