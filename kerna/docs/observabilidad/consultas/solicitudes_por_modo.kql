// Solicitudes por modo de generación (oficial, respaldo, local, manual), recuperación (nube, local) y tasa de conmutación.
// Conmutación = contingencia true (modo distinto de oficial o recuperación local).
AppTraces
| where TimeGenerated > ago(7d) and AppRoleName == "kerna.kerna-nucleo" and Message == "solicitud_terminada"
| extend modo = coalesce(tostring(Properties.modo), "manual"), recuperacion = coalesce(tostring(Properties.recuperacion), "nube"),
         contingencia = tostring(Properties.contingencia) =~ "true" or coalesce(tostring(Properties.modo), "manual") != "oficial" or coalesce(tostring(Properties.recuperacion), "nube") == "local"
| summarize solicitudes = count(), conmutadas = countif(contingencia) by modo, recuperacion
| extend tasa_conmutacion_pct = round(100.0 * conmutadas / solicitudes, 1)
| order by solicitudes desc
