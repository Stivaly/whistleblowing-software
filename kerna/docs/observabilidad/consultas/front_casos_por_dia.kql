// Front /panel: casos procesados por día (solicitudes terminadas). Solo conteos.
AppTraces
| where TimeGenerated > ago(7d) and AppRoleName == "kerna.kerna-nucleo" and Message == "solicitud_terminada"
| summarize casos = count(), con_sugerencia = countif(tostring(Properties.estado) == "completada") by dia = bin(TimeGenerated, 1d)
| order by dia asc
